DATABASE_URL=sqlite:///./test.db

# Channel 1: Gmail SMTP (29 Indian States sent via bidding.gisfy@gmail.com at 09:30 AM IST)
# Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=bidding.gisfy@gmail.com
GMAIL_APP_PASSWORD=

# Channel 2: Microsoft 365 Mailbox (ADB Multilateral sent via support@gisfy.co.in at 10:30 AM IST)
M365_SMTP_HOST=smtp.office365.com
M365_SMTP_PORT=587
M365_SMTP_USER=support@gisfy.co.in
M365_SMTP_PASSWORD=

# Microsoft 365 Entra ID OAuth 2.0 (Preferred Alternative to SMTP)
M365_TENANT_ID=de9e8583-c4c4-4212-9c27-e35cfa247419
M365_CLIENT_ID=c2cd8349-a198-46d6-a6dc-325e86dd67a4
M365_CLIENT_SECRET=
M365_REDIRECT_URI=http://localhost:8000/api/collaboration/m365/callback

# Default Fallback SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=support@gisfy.co.in
SMTP_PASSWORD=
SMTP_FROM=GISFY Support <support@gisfy.co.in>
SMTP_CC=bidding@gisfy.co.in
SMTP_REPLY_TO=support@gisfy.co.in

