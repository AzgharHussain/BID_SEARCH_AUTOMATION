# ==============================================================================
# GISFY Automated Proposals - Backend Environment Configuration Template
# ==============================================================================

# Database Connection (SQLite default with preloaded portals, tenders, and documents)
DATABASE_URL=sqlite:///./test.db

# ------------------------------------------------------------------------------
# Outbound Email Dispatch Configuration (Optional)
# ------------------------------------------------------------------------------
# If left commented out, the system safely operates in local preview mode
# and archives full HTML emails in: backend/storage/sent_emails/
#
# To enable real inbox delivery via Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=your_sending_address@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=GISFY Procurement System <your_sending_address@gmail.com>

# To enable via Corporate Office 365 / Exchange SMTP:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=notifications@gisfy.co.in
# SMTP_PASSWORD=your_password
# SMTP_FROM=GISFY Procurement System <notifications@gisfy.co.in>
